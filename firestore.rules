rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function spacePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isSpaceMember(spaceId) {
      return signedIn()
        && exists(spacePath(spaceId))
        && request.auth.uid in get(spacePath(spaceId)).data.users;
    }

    function sharesCurrentSpaceWith(userId) {
      let currentSpaceId = get(userPath(request.auth.uid)).data.spaceId;
      return currentSpaceId != null
        && isSpaceMember(currentSpaceId)
        && userId in get(spacePath(currentSpaceId)).data.users;
    }

    // Users profile
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || sharesCurrentSpaceWith(userId));
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // A private shared space. Knowing the invite code permits a single-document
    // lookup and joining, but never listing spaces or reading their books.
    match /spaces/{spaceId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'users', 'createdAt'])
        && request.resource.data.id == spaceId
        && request.resource.data.users == [request.auth.uid];
      allow update: if signedIn()
        && !isSpaceMember(spaceId)
          && resource.data.users.size() < 2
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
          && request.resource.data.users.size() == resource.data.users.size() + 1
          && request.resource.data.users.hasAll(resource.data.users)
          && request.resource.data.users.hasAll([request.auth.uid]);
      allow delete: if false;

      // Books subcollection
      match /books/{bookId} {
        allow read, write: if isSpaceMember(spaceId);
      }

      // Discussions subcollection
      match /discussions/{discussionId} {
        allow read, write: if isSpaceMember(spaceId);
      }

      // AI-generated current thought flow and immutable prior versions.
      match /flow/{flowId} {
        allow read, write: if isSpaceMember(spaceId);
      }

      match /flowHistory/{historyId} {
        allow read, write: if isSpaceMember(spaceId);
      }
    }
  }
}
