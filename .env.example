# Server-only. Never prefix this value with VITE_ or commit a real key.
OPENAI_API_KEY=""

# Optional server-side model override.
OPENAI_MODEL="gpt-5-mini"

# Optional model used for the thought-flow analysis.
OPENAI_FLOW_MODEL="gpt-5.6-terra"

# Server-side Firebase token verification (this ID is not a secret).
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Firebase Client Configuration
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
